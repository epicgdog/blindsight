# Secrets: never commit credentials (Matterport keys live in .env.local)
.env*
!.env.example

# Local demo sessions and regenerated Part 3 artifacts
data/sessions/
data/synthetic/
data/eval/cache/
data/onsite/
data/negatives/

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
data/pano/*/cache/

# Matterport imagery stays on the machine that downloaded it (public repo; check the
# track's data terms before publishing). pano.json, layout.json and calibration stay tracked.
data/pano/**/*.jpg
data/matterport/panoLocations.json
